MAIL_MODE=imap_smtp
MAIL_EMAIL=your_email@example.com
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
MAIL_SYNC_LIMIT=30
MAIL_SYNC_DAYS=30
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_AUTH_CODE=your_authorization_code_or_app_password

