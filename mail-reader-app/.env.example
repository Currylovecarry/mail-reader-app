MAIL_MODE=imap_smtp
MAIL_EMAIL=your_email@example.com
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
MAIL_SYNC_LIMIT=50
MAIL_SYNC_DAYS=3650
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_AUTH_CODE=your_authorization_code_or_app_password

# Order recognition: high-confidence spreadsheets use the local fast path;
# DeepSeek handles ambiguous body text, images, PDFs, and incomplete tables.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your_deepseek_api_key
LLM_TIMEOUT_MS=30000
# Keep disabled while benchmarking so every request runs independently.
ORDER_DRAFT_CACHE_ENABLED=false

# Optional: keep the original Agent Mail mode available.
# MAIL_MODE=agent
# AGENT_MAIL_ALIAS=cq7777@agent.qq.com
